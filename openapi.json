{
  "openapi": "3.1.0",
  "info": {
    "title": "ElderHelp API",
    "description": "Evidence-grounded answers from approved age-friendly reports.",
    "version": "1.0.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Health",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Readiness",
        "operationId": "readiness_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reports": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Reports",
        "operationId": "reports_v1_reports_get",
        "parameters": [
          {
            "name": "community",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "title": "Community"
            }
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2200,
                  "minimum": 1900
                },
                {
                  "type": "null"
                }
              ],
              "title": "Year"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/reports/{report_id}": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Report",
        "operationId": "report_v1_reports__report_id__get",
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Report Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/answers/stream": {
      "post": {
        "tags": [
          "answers"
        ],
        "summary": "Answer Stream",
        "operationId": "answer_stream_v1_answers_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "SSE answer stream",
            "content": {
              "text/event-stream": {}
            }
          },
          "422": {
            "description": "Invalid request"
          },
          "503": {
            "description": "RAG provider is not configured"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerFilters": {
        "properties": {
          "report_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Report Ids"
          },
          "community": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Community"
          },
          "year_from": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2200.0,
                "minimum": 1900.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Year From"
          },
          "year_to": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2200.0,
                "minimum": 1900.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Year To"
          }
        },
        "type": "object",
        "title": "AnswerFilters"
      },
      "AnswerRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "type": "array",
            "maxItems": 6,
            "title": "History"
          },
          "filters": {
            "$ref": "#/components/schemas/AnswerFilters"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AnswerRequest"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "not_ready"
            ],
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "checks": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Checks"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "timestamp"
        ],
        "title": "HealthResponse"
      },
      "ReportDetail": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "publisher": {
            "type": "string",
            "title": "Publisher"
          },
          "community": {
            "type": "string",
            "title": "Community"
          },
          "publication_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Publication Date"
          },
          "source_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Source Url"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "suggested_questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Suggested Questions"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "publisher",
          "community",
          "source_url",
          "page_count"
        ],
        "title": "ReportDetail"
      },
      "ReportList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReportSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "ReportList"
      },
      "ReportSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "publisher": {
            "type": "string",
            "title": "Publisher"
          },
          "community": {
            "type": "string",
            "title": "Community"
          },
          "publication_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Publication Date"
          },
          "source_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "title",
          "publisher",
          "community",
          "source_url"
        ],
        "title": "ReportSummary"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Citation": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "report_id": {
            "format": "uuid",
            "title": "Report Id",
            "type": "string"
          },
          "report_title": {
            "title": "Report Title",
            "type": "string"
          },
          "publisher": {
            "title": "Publisher",
            "type": "string"
          },
          "source_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          },
          "publication_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Publication Date"
          },
          "page_number": {
            "title": "Page Number",
            "type": "integer"
          },
          "excerpt": {
            "title": "Excerpt",
            "type": "string"
          }
        },
        "required": [
          "id",
          "report_id",
          "report_title",
          "publisher",
          "source_url",
          "page_number",
          "excerpt"
        ],
        "title": "Citation",
        "type": "object"
      },
      "AnswerComplete": {
        "properties": {
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "answer_markdown": {
            "title": "Answer Markdown",
            "type": "string"
          },
          "status": {
            "enum": [
              "grounded",
              "insufficient_evidence"
            ],
            "title": "Status",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "title": "Citations",
            "type": "array"
          }
        },
        "required": [
          "request_id",
          "answer_markdown",
          "status",
          "citations"
        ],
        "title": "AnswerComplete",
        "type": "object"
      },
      "StartEvent": {
        "properties": {
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id"
        ],
        "title": "StartEvent",
        "type": "object"
      },
      "ProgressEvent": {
        "properties": {
          "stage": {
            "enum": [
              "planning",
              "retrieving",
              "verifying"
            ],
            "title": "Stage",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "stage",
          "message"
        ],
        "title": "ProgressEvent",
        "type": "object"
      },
      "DeltaEvent": {
        "properties": {
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "DeltaEvent",
        "type": "object"
      },
      "ErrorEvent": {
        "properties": {
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "code": {
            "enum": [
              "quota_exhausted",
              "timeout",
              "unavailable",
              "corpus_changed"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "search_available": {
            "default": true,
            "title": "Search Available",
            "type": "boolean"
          }
        },
        "required": [
          "request_id",
          "code",
          "message"
        ],
        "title": "ErrorEvent",
        "type": "object"
      },
      "CitationV2": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "report_id": {
            "format": "uuid",
            "title": "Report Id",
            "type": "string"
          },
          "report_title": {
            "title": "Report Title",
            "type": "string"
          },
          "publisher": {
            "title": "Publisher",
            "type": "string"
          },
          "source_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          },
          "publication_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Publication Date"
          },
          "page_number": {
            "title": "Page Number",
            "type": "integer"
          },
          "excerpt": {
            "title": "Excerpt",
            "type": "string"
          },
          "revision_id": {
            "format": "uuid",
            "title": "Revision Id",
            "type": "string"
          },
          "span_id": {
            "format": "uuid",
            "title": "Span Id",
            "type": "string"
          },
          "page_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Page Label"
          }
        },
        "required": [
          "id",
          "report_id",
          "report_title",
          "publisher",
          "source_url",
          "page_number",
          "excerpt",
          "revision_id",
          "span_id"
        ],
        "title": "CitationV2",
        "type": "object"
      },
      "CompleteV2": {
        "properties": {
          "request_id": {
            "format": "uuid",
            "title": "Request Id",
            "type": "string"
          },
          "answer_markdown": {
            "title": "Answer Markdown",
            "type": "string"
          },
          "status": {
            "enum": [
              "grounded",
              "partial",
              "insufficient_evidence",
              "clarification_required"
            ],
            "title": "Status",
            "type": "string"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationV2"
            },
            "title": "Citations",
            "type": "array"
          },
          "missing_parts": {
            "items": {
              "type": "string"
            },
            "title": "Missing Parts",
            "type": "array"
          },
          "corpus_generation": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Corpus Generation"
          }
        },
        "required": [
          "request_id",
          "answer_markdown",
          "status"
        ],
        "title": "CompleteV2",
        "type": "object"
      }
    }
  }
}
