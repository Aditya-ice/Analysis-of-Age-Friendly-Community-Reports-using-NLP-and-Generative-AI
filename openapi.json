  "components": {
    "schemas": {
      "AnswerFilters": {
        "properties": {
          "report_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Report Ids"
          },
          "community": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Community"
          },
          "year_from": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2200.0,
                "minimum": 1900.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Year From"
          },
          "year_to": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2200.0,
                "minimum": 1900.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Year To"
          }
        },
        "type": "object",
        "title": "AnswerFilters"
      },
      "AnswerRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "type": "array",
            "maxItems": 6,
            "title": "History"
          },
          "filters": {
            "$ref": "#/components/schemas/AnswerFilters"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AnswerRequest"
      },
      "Capabilities": {
        "properties": {
          "generation_available": {
            "type": "boolean",
            "title": "Generation Available"
          },
          "search_available": {
            "type": "boolean",
            "title": "Search Available"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "corpus_generation": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corpus Generation"
          },
          "supported_filters": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Supported Filters",
            "default": [
              "report_ids",
              "community",
              "year_from",
              "year_to"
            ]
          }
        },
        "type": "object",
        "required": [
          "generation_available",
          "search_available"
        ],
        "title": "Capabilities"
      },
      "ChatTurn": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn"
      },
      "CitationV2": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "report_id": {
            "format": "uuid",
            "title": "Report Id",
            "type": "string"
          },
          "report_title": {
            "title": "Report Title",
            "type": "string"
          },
          "publisher": {
            "title": "Publisher",
            "type": "string"
          },
          "source_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          },
          "publication_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Publication Date"
          },
          "page_number": {
            "title": "Page Number",
            "type": "integer"
          },
          "excerpt": {
            "title": "Excerpt",
            "type": "string"
          },
          "revision_id": {
            "format": "uuid",
            "title": "Revision Id",
            "type": "string"
          },
          "span_id": {
            "format": "uuid",
            "title": "Span Id",
            "type": "string"
          },
          "page_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Page Label"
          }
        },
        "required": [
          "id",
          "report_id",
          "report_title",
          "publisher",
          "source_url",
          "page_number",
          "excerpt",
          "revision_id",
          "span_id"
        ],
        "title": "CitationV2",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
