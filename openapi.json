              "delta": "DeltaEvent",
              "complete": "AnswerComplete",
              "error": "ErrorEvent"
            }
          },
          "401": {
            "description": "Invite/session required"
          },
          "413": {
            "description": "Request body too large"
          },
          "422": {
            "description": "Invalid input"
          },
          "429": {
