    "/v2/answers/stream": {
      "post": {
        "tags": [
          "answers"
        ],
        "summary": "Answer Stream",
        "operationId": "answer_stream_v2_answers_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "SSE start, progress, verified delta, complete; typed error on failure",
            "content": {
              "text/event-stream": {}
            },
            "x-sse-events": {
              "start": "StartEvent",
              "progress": "ProgressEvent",
              "delta": "DeltaEvent",
              "complete": "CompleteV2",
              "error": "ErrorEvent"
            }
          },
          "401": {
            "description": "Invite/session required"
          },
          "413": {
            "description": "Request body too large"
          },
          "422": {
            "description": "Invalid input"
          },
          "429": {
            "description": "Quota/concurrency limit; Retry-After header"
          },
          "503": {
            "description": "Required dependency unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/answers/stream": {
