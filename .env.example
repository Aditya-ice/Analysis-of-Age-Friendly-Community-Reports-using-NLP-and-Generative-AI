ELDERHELP_ENVIRONMENT=development
ELDERHELP_DATABASE_URL=postgresql+asyncpg://elderhelp:elderhelp@localhost:5432/elderhelp
# Set these privately. Never commit a key or invite code.
ELDERHELP_GOOGLE_API_KEY=
# Confirm billing is disabled and account limits checked BEFORE enabling live calls.
ELDERHELP_FREE_TIER_CONFIRMED=false
# Generate a random secret of at least 32 characters; no shared default exists.
# ELDERHELP_TOKEN_SECRET=
ELDERHELP_GENERATION_MODEL=gemini-3.6-flash
ELDERHELP_EMBEDDING_MODEL=gemini-embedding-2
ELDERHELP_EMBEDDING_DIMENSIONS=768
ELDERHELP_ANSWERS_DAILY_LIMIT=20
ELDERHELP_ANSWERS_MINUTE_LIMIT=6
ELDERHELP_GENERATION_DAILY_LIMIT=60
ELDERHELP_EMBEDDING_DAILY_LIMIT=200
ELDERHELP_SESSION_DAILY_LIMIT=5
ELDERHELP_INVITE_DAILY_LIMIT=20
ELDERHELP_RERANKER_DIRECTORY=models/reranker
ELDERHELP_CORS_ORIGINS=[]
